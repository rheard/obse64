#include "obse64_common/obse64_version.h"

1 VERSIONINFO
 FILEVERSION XOBSE64_VERSION_MAJOR,XOBSE64_VERSION_MINOR,XOBSE64_VERSION_PATCH,0
 PRODUCTVERSION XOBSE64_VERSION_MAJOR,XOBSE64_VERSION_MINOR,XOBSE64_VERSION_PATCH,0
 FILEFLAGSMASK 0x17L
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x4L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "xOBSE64 core DLL"
			VALUE "FileVersion", XOBSE64_VERSION_STRING
            VALUE "InternalName", "xOBSE64"
            VALUE "LegalCopyright", "Copyright (C) 2006-2025"
            VALUE "ProductName", "xOBSE64"
			VALUE "ProductVersion", XOBSE64_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
